# 视觉验收产物：visual_shots.cjs 生成的明暗两套页面截图（29MB，仅供人工核对）。
# 脚本本身入库，产物不入库 —— 需要时重跑 `node internal/admin/visual_shots.cjs`。
internal/admin/_shots/
# 功能盘点 / 验收核对的运行产物（脚本入库，结果不入库）
internal/admin/_inventory*.json
internal/admin/_acceptance.json

# 前端依赖：后台 UI 冒烟测试用的 playwright（本机 npm i 产生，不入库）；
# 它还会抢 NODE_PATH 的解析，跑测试时请用仓库外的依赖或临时移开
node_modules/

# 逆向资料（客户端文件/反编译产物/抓包），只留在本地，永不入库
/ref/
il2csharp_full

tools/*
!tools/*.ps1
!tools/*.py
!tools/genwire/
!tools/doccheck/
!tools/refscan/

# 版本更新检测的本地状态
/update_state.json

# 镜像内的预置 Docker 配置
!/docker/config.yaml
/docker/.env

# WorkBuddy 项目记忆（本地工作日志，不入库）
.workbuddy/
