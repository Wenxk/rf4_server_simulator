  "schema_version": 3,
  "unit": "silver_per_kg",
  "source": {
    "level_009_ahtuba": {
      "map_name_zh": "阿赫图巴河",
      "kind": "rf4db.com player-reported + 玩家截图校对",
      "url": "https://rf4db.com/zh/market?map=level_009_ahtuba",
      "columns": "1=未达标基准价（银/kg）；达标/上星/蓝冠由代码阶梯 1:1.5:3:6 生成",
      "note": "基准价（market_pct=1.0），其他地图由 map_market_multipliers.json 折算"
    }
  },
  "note": "by_map[map][species][\"1\"] 为未达标基准价（银/kg）；四档价由代码统一阶梯生成，表里不再存 2/3/4。",
  "caveat": "2026-11-23 起四档统一为 1:1.5:3:6（原逐种上报的档位价见 git 历史），只保留未达标基准价。",
  "revisions": [
    {
      "date": "2026-11-23",
      "reason": "默认值一致性校正（specs/changes/species-econ-default-audit）",
      "changes": [
        "9 行上星价低于达标价：上星价对齐达标价，蓝冠价不低于 1.5×上星价",
        "补齐 roach（沿用 c.roach）与 bs_salmon（沿用 l_salmon）四档价"
      ]
    },
    {
      "date": "2026-11-23",
      "reason": "四档统一阶梯（specs/changes/unified-grade-ladder）",
      "changes": [
        "价表只存未达标基准价，达标=1.5×、上星=3×、蓝冠=6× 由加载时生成",
        "原 2/3/4 列删除；此前 253 种的达标价与未达标价完全相同的畸形随之消失"
      ]
    },
    {
      "date": "2026-11-23",
      "reason": "溢价异常校正（specs/changes/fish-price-outlier-audit）",
      "changes": [
        "chimaera 1122.00→219.41、c_anguineus 77.10→16.38、himant_g 207.18→79.98 银/kg（基准水域）",
        "依据：单条蓝冠价值超同体型 p90 的 5 倍；收敛到 p90×2，保留深海稀有溢价",
        "只改基准价，四档阶梯与其余 250 种价格不变"
      ]
    },
    {
      "date": "2026-11-23",
      "reason": "稀有度与单价对齐（specs/changes/rarity-price-alignment）",
      "changes": [
        "20 种稀有/超稀有鱼的单价低于同克重普通鱼 p90，已提到 p90 之上（保持组内区分度）",
        "最严重：n_carp 无鳞鲤 2.62→9.20（原仅同档普通鱼的 0.94 倍）、b_carp 3.15→9.48、din_l_carp 4.67→10.03",
        "只改基准价，四档阶梯、其余 233 种价格、饵料鱼与巨型鱼均不动"
      ]
    },
    {
      "date": "2026-11-23",
      "reason": "稀有度对齐补漏（specs/changes/rarity-price-alignment）",
      "changes": [
        "全量 253 种复验：5 种稀有鱼单价齐平或低于同量级普通鱼 p90，已提到 p90 之上（留 1%~25% 溢价）",
        "n_carp 9.20→11.50、sh_barbel 14.61→18.26、syb_sterlet 20.45→25.56（原与普通鱼同价，零溢价）",
        "eel 24.36→26.65、g_tench 26.20→28.06（首轮齐平 p90）",
        "判定式收紧为「稀有鱼单价 >= 同量级普通鱼 p90 × 1.01」，并排除被判定鱼自身防止 p90 自指",
        "新增 tools/fish_price_audit.py 可复现全量审计；饵料鱼按 loc_bait_fish.bait 饵名判定（26 种）"
      ]
    },
    {
      "date": "2026-11-25",
      "reason": "把后台 species_econ 的逐档实价合并进资产基线（覆盖表随之清空）",
      "changes": [
        "frog / chimaera / bh_carp / lophius_p / c_anguineus 的 2/3/4 档写入显式值，不再由 1:1.5:3:6 阶梯推算",
        "applyPriceGradeLadder 改为「表里有值优先、缺档才按阶梯补」，原先无条件重算会把这些实价压平",
        "c_lamprey / u_lamprey / fe_lamprey 只改经验、无价格覆盖，价表不动"
      ]
    }
  ],
